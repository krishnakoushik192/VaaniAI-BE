{
  "name": "vanni-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Vanni AI backend: shopkeepers, customers, bills and dues (Express + MongoDB)",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "smoke": "tsx scripts/smoke.ts",
    "make-audio": "tsx --env-file-if-exists=.env scripts/make-test-audio.ts",
    "voice-test": "tsx --env-file-if-exists=.env scripts/voice-test.ts",
    "test:audio": "tsx scripts/audio-split-test.ts"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.8",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "mongodb-memory-server": "^10.4.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": "1"
    }
  }
}
