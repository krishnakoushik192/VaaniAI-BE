# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=vanni

# Long random string used to sign login tokens.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Comma-separated origins allowed by CORS. Leave empty to allow all (fine for a mobile app).
CORS_ORIGINS=

PORT=4000

# Speech-to-text (app.gnani.ai) and Google AI Studio (Gemini) keys
GNANI_API_KEY=
LLM_API_KEY=
# Optional, defaults to gemini-3.5-flash-lite
# GEMINI_MODEL=
